# Copier vers .env.test (ignoré par git). Aucune valeur ici.
# Les mêmes noms peuvent déjà être dans .env.local : les tests les lisent sans les exposer à l'app.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optionnel. Défaut : http://localhost:3000. En CI, URL de prévisualisation Vercel.
E2E_BASE_URL=

# Optionnel. "1" affiche le formulaire mot de passe quand le serveur n'est pas en development.
E2E_PASSWORD_LOGIN=
